# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobpulse
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20
DB_MIN_IDLE=5

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security
JWT_SECRET=your-super-secret-key-change-in-production-minimum-256-bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Job Ingestion
JOB_INGESTION_ENABLED=true

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8081
AI_SERVICE_TIMEOUT_SECONDS=30

# OpenAI Configuration (for Phase 3+)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Email Configuration (for Phase 6)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@jobpulse.com

# Notification Configuration
NOTIFICATION_ENABLED=true
NOTIFICATION_BATCH_SIZE=50

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_PER_USER=100

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/jobpulse.log

# Environment
ENVIRONMENT=development

