# Local-only configuration. start-mac.sh generates .env if absent.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobpulse
DB_USERNAME=jobpulse
DB_PASSWORD=replace-with-a-unique-local-password
# Generate with: openssl rand -hex 64 (HS512 requires at least 64 bytes)
JWT_SECRET=replace-with-at-least-64-random-bytes-before-starting-the-server
SERVER_PORT=8080
JOBPULSE_OLLAMA_URL=http://localhost:11434
JOBPULSE_OLLAMA_MODEL=qwen3:4b
# Real employer board slugs; availability and roles vary. No vacancy is guaranteed.
JOBPULSE_FEEDS_GREENHOUSE_BOARDS=canonical,reddit,gitlab
JOBPULSE_FEEDS_LEVER_SITES=ataccama,caseware
JOBPULSE_FEEDS_INCLUDE_MOCK=false
